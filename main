def add_blacklist_sync(pattern, admin_id):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    try:
        c.execute("INSERT INTO blacklist (pattern, added_by, added_at) VALUES (?, ?, ?)",
                  (pattern, admin_id, datetime.now().isoformat()))
        conn.commit()
        conn.close()
        return True
    except sqlite3.IntegrityError:
        conn.close()
        return False

async def add_blacklist(pattern, admin_id):
    return await run_sync(add_blacklist_sync, pattern, admin_id)

def remove_blacklist_sync(pattern):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("DELETE FROM blacklist WHERE pattern=?", (pattern,))
    conn.commit()
    conn.close()

async def remove_blacklist(pattern):
    await run_sync(remove_blacklist_sync, pattern)

def is_blacklisted_sync(pattern):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT pattern FROM blacklist WHERE pattern=?", (pattern,))
    row = c.fetchone()
    conn.close()
    return row is not None

async def is_blacklisted(pattern):
    return await run_sync(is_blacklisted_sync, pattern)

