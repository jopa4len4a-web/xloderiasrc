def use_referral_sync(code, user_id):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("UPDATE referrals SET used_by=?, used_at=? WHERE referral_code=?",
              (user_id, datetime.now().isoformat(), code))
    conn.commit()
    conn.close()

async def use_referral(code, user_id):
    await run_sync(use_referral_sync, code, user_id)

def get_stats_sync():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT COUNT(*) FROM users")
    users = c.fetchone()[0]
    c.execute("SELECT COUNT(*) FROM blacklist")
    bl = c.fetchone()[0]
    c.execute("SELECT COUNT(*) FROM support_tickets WHERE status='open'")
    tickets = c.fetchone()[0]
    conn.close()
    return users, bl, tickets

# ===== РЕАЛЬНЫЕ ИСТОЧНИКИ (без имитации) =====

async def search_hibp(email: str) -> list:
    url = f"https://haveibeenpwned.com/api/v3/breachedaccount/{email}"
    headers = {"hibp-api-key": "", "User-Agent": "Xloderia/1.0"}
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, headers=headers, timeout=10) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    return [f"{b['Name']} ({b['BreachDate']}) — {', '.join(b['DataClasses'])}" for b in data]
                elif resp.status == 404:
                    return []
                else:
                    return [f"Ошибка HIBP: {resp.status}"]
        except:
            return ["Ошибка соединения с HIBP"]

async def search_scylla(query: str) -> list:
    url = "https://scylla.so/api/search"
    params = {"q": query, "size": 3}
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, params=params, timeout=10) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    results = data.get("results", [])
                    if results:
                        return [f"{r.get('source', 'unknown')}: {r.get('value', '')}" for r in results[:3]]
                return []
        except:
            return ["Ошибка Scylla"]

async def search_leaklookup(query: str) -> list:
    if not LEAKLOOKUP_KEY:
        return ["Leak-Lookup не активен (ключ отсутствует)"]
    url = "https://leak-lookup.com/api/search"
    params = {"key": LEAKLOOKUP_KEY, "type": "email" if "@" in query else "username", "query": query}
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, params=params, timeout=10) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("success"):
                        return [f"{entry['source']}: {entry['value']}" for entry in data.get("results", [])[:3]]
                return []
        except:
            return ["Ошибка Leak-Lookup"]

async def search_breachdirectory(query: str) -> list:
    if not BREACHDIRECTORY_KEY:
        return ["BreachDirectory не активен (ключ отсутствует)"]
    url = "https://breachdirectory.org/api/v1/search"
    params = {"key": BREACHDIRECTORY_KEY, "query": query}
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, params=params, timeout=10) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("found"):
                        return [f"{entry['source']}: {entry['value']}" for entry in data.get("results", [])[:3]]
                return []
        except:
            return ["Ошибка BreachDirectory"]

async def search_niamonx(endpoint: str, query: str) -> list:
    if not NIAMONX_KEY:
        return [f"{endpoint} не активен (ключ NiamonX отсутствует)"]
    url = f"https://data-wells.niamonx.io/api/breach/{endpoint}"
    headers = {"Authorization": f"Bearer {NIAMONX_KEY}"}
    params = {"q": query}
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, headers=headers, params=params, timeout=10) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("results"):
                        return [f"{r.get('type', '')}: {r.get('value', '')}" for r in data["results"][:3]]
                return []
        except:
            return [f"Ошибка {endpoint}"]

async def search_all(query: str) -> dict:
    query = query.strip()
    if await is_blacklisted(query):
        return {"error": "⛔ Данные скрыты администратором"}

    results = {}
    # HIBP (только email)
    if "@" in query and "." in query:
        hibp_res = await search_hibp(query)
        if hibp_res and not hibp_res[0].startswith("Ошибка"):
            results["Have I Been Pwned"] = hibp_res

    # Scylla
    scy_res = await search_scylla(query)
    if scy_res and not scy_res[0].startswith("Ошибка"):
        results["Scylla.so"] = scy_res

    # Leak-Lookup
    ll_res = await search_leaklookup(query)
    if ll_res and not ll_res[0].startswith("не активен") and not ll_res[0].startswith("Ошибка"):
        results["Leak-Lookup"] = ll_res

    # BreachDirectory
    bd_res = await search_breachdirectory(query)
    if bd_res and not bd_res[0].startswith("не активен") and not bd_res[0].startswith("Ошибка"):
        results["BreachDirectory"] = bd_res

    # Российские БД через NiamonX
    if NIAMONX_KEY:
        russian_endpoints = ["QZaem-sample", "I-GIS", "2GIS-2025", "Azur.ru", "NeedSpec.ru",
                             "torlog", "podrygka", "bdu", "leakcheck", "himera",
                             "leakosint", "dyxless", "gta", "opendata", "getairplane"]
        for ep in russian_endpoints:
            res = await search_niamonx(ep, query)
            if res and not res[0].startswith("не активен") and not res[0].startswith("Ошибка"):
                results[ep] = res

    return results

# ===== ОБРАБОТЧИКИ КОМАНД =====

async def start(update: Update, context):
    user = update.effective_user
    await register_user(user.id, user.username, user.first_name, user.last_name)
    if context.args:
        code = context.args[0]
        owner = await get_referral_owner(code)
        if owner:
            await use_referral(code, user.id)
            await update.message.reply_text("✅ Реферальный код активирован!")
    await update.message.reply_text(
        f"🔍 {BOT_NAME} 2.0 — поиск по реальным базам утечек.\n"
        f"Отправьте email, телефон, username или ФИО.\n"
        f"Команды: /admin, /support, /referral"
    )

async def admin_panel(update: Update, context):
    if not await is_admin(update.effective_user.id):
        await update.message.reply_text("⛔ Только для админов.")
        return
    keyboard = [
        [InlineKeyboardButton("👥 Добавить админа", callback_data="admin_add")],
        [InlineKeyboardButton("🗑 Удалить админа", callback_data="admin_remove")],
        [InlineKeyboardButton("⛔ Добавить в чёрный список", callback_data="blacklist_add")],
        [InlineKeyboardButton("✅ Удалить из чёрного списка", callback_data="blacklist_remove")],
        [InlineKeyboardButton("🎫 Назначить техподдержку", callback_data="support_add")],
        [InlineKeyboardButton("❌ Снять техподдержку", callback_data="support_remove")],
        [InlineKeyboardButton("📩 Тикеты поддержки", callback_data="support_tickets")],
        [InlineKeyboardButton("📊 Статистика", callback_data="stats")],
        [InlineKeyboardButton("❓ Помощь по админке", callback_data="admin_help")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    await update.message.reply_text("🛠 Админ-панель", reply_markup=reply_markup)

async def admin_callback(update: Update, context):
    query = update.callback_query
    await query.answer()
    data = query.data
    user_id = update.effective_user.id

    if not await is_admin(user_id):
        await query.edit_message_text("⛔ Доступ запрещён.")
        return

    if data == "admin_add":
        await query.edit_message_text("Используйте команду: `/addadmin <ID>`", parse_mode="Markdown")
    elif data == "admin_remove":
        await query.edit_message_text("Используйте команду: `/rmadmin <ID>`", parse_mode="Markdown")
    elif data == "blacklist_add":
        await query.edit_message_text("Используйте команду: `/bladd <ФИО/телефон/email>`", parse_mode="Markdown")
    elif data == "blacklist_remove":
        await query.edit_message_text("Используйте команду: `/blrm <ФИО/телефон/email>`", parse_mode="Markdown")
    elif data == "support_add":
        await query.edit_message_text("Используйте команду: `/supportadd <ID>`", parse_mode="Markdown")
    elif data == "support_remove":
        await query.edit_message_text("Используйте команду: `/supportrm <ID>`", parse_mode="Markdown")
    elif data == "support_tickets":
        tickets = await get_open_tickets()
        if not tickets:
            await query.edit_message_text("📭 Нет открытых тикетов.")
            return
        msg = "📩 Открытые тикеты:\n"
        for t in tickets:
            msg += f"#{t[0]} от {t[1]} ({t[3]}): {t[2][:50]}...\n"
        msg += "\nЧтобы ответить: `/reply <id> <текст>`"
        await query.edit_message_text(msg, parse_mode="Markdown")
    elif data == "stats":
        users, bl, tickets = await run_sync(get_stats_sync)
        await query.edit_message_text(
            f"📊 *Статистика*\n👤 Пользователей: {users}\n⛔ В чёрном списке: {bl}\n📩 Открытых тикетов: {tickets}",
            parse_mode="Markdown"
        )
    elif data == "admin_help":
        help_text = (
            "📖 *Помощь по админке*\n\n"
            "Команды:\n"
            "`/addadmin <ID>` – добавить админа\n"
            "`/rmadmin <ID>` – удалить админа\n"
            "`/bladd <текст>` – добавить в чёрный список\n"
            "`/blrm <текст>` – удалить из чёрного\n"
            "`/supportadd <ID>` – назначить техподдержку\n"
            "`/supportrm <ID>` – снять техподдержку\n"
            "`/reply <ID> <текст>` – ответить на тикет\n\n"
            "Чёрный список блокирует выдачу данных по запросу.\n"
            "Техподдержка может отвечать на тикеты.\n\n"
            "Активные источники: HIBP, Scylla, Leak-Lookup, BreachDirectory, NiamonX (российские БД).\n"
            "Для работы платных источников задайте ключи в переменных окружения:\n"
            "LEAKLOOKUP_KEY, BREACHDIRECTORY_KEY, NIAMONX_KEY."
        )
        await query.edit_message_text(help_text, parse_mode="Markdown")

async def support_command(update: Update, context):
    user_id = update.effective_user.id
    text = update.message.text
    if len(text) <= 8:
        await update.message.reply_text("Напишите /support <ваше сообщение>")
        return
    msg = text[9:].strip()
    if not msg:
        await update.message.reply_text("Сообщение не может быть пустым.")
        return
    await create_ticket(user_id, msg)
    await update.message.reply_text("✅ Обращение создано. Ожидайте ответа.")

async def referral_command(update: Update, context):
    user_id = update.effective_user.id
    code = await generate_referral_code(user_id)
    await update.message.reply_text(f"Ваша реферальная ссылка:\n`/start {code}`", parse_mode="Markdown")

async def handle_message(update: Update, context):
    text = update.message.text
    if not text or text.startswith('/'):
        return

    results = await search_all(text)
    if isinstance(results, dict) and "error" in results:
        await update.message.reply_text(results["error"])
        return

    if not results:
        await update.message.reply_text("❌ Ничего не найдено ни в одном источнике.")
        return

    output = []
    for src, entries in results.items():
        if entries and not entries[0].startswith("не активен") and not entries[0].startswith("Ошибка"):
            output.append(f"📌 {src}:")
            for e in entries:
                output.append(f"   • {e}")
            output.append("")

    if not output:
        await update.message.reply_text("❌ Ничего не найдено.")
        return

    reply = "\n".join(output)
    if len(reply) > 4096:
        reply = reply[:4093] + "..."
    await update.message.reply_text(reply)

# ===== АДМИН-КОМАНДЫ (реализация) =====
async def addadmin(update, context):
    if not await is_admin(update.effective_user.id): return
    if not context.args: return
    target = int(context.args[0])
    await add_admin(target)
    await update.message.reply_text(f"✅ Пользователь {target} стал админом.")

async def rmadmin(update, context):
    if not await is_admin(update.effective_user.id): return
    if not context.args: return
    target = int(context.args[0])
    if await remove_admin(target):
        await update.message.reply_text(f"✅ Админ {target} снят.")
    else:
        await update.message.reply_text("❌ Нельзя удалить последнего админа.")

async def bladd(update, context):
    if not await is_admin(update.effective_user.id): return
    if not context.args: return
    pattern = " ".join(context.args)
    if await add_blacklist(pattern, update.effective_user.id):
        await update.message.reply_text(f"✅ Добавлено в чёрный список: {pattern}")
    else:
        await update.message.reply_text("❌ Ошибка (возможно уже есть).")

async def blrm(update, context):
    if not await is_admin(update.effective_user.id): return
    if not context.args: return
    pattern = " ".join(context.args)
    await remove_blacklist(pattern)
    await update.message.reply_text(f"✅ Удалено из чёрного списка: {pattern}")

async def supportadd(update, context):
    if not await is_admin(update.effective_user.id): return
    if not context.args: return
    target = int(context.args[0])
    await set_support(target)
    await update.message.reply_text(f"✅ Пользователь {target} назначен техподдержкой.")

async def supportrm(update, context):
    if not await is_admin(update.effective_user.id): return
    if not context.args: return
    target = int(context.args[0])
    await remove_support(target)
    await update.message.reply_text(f"✅ Техподдержка снята с {target}.")

async def reply_ticket_cmd(update, context):
    if not await is_admin(update.effective_user.id) and not await is_support(update.effective_user.id):
        return
    if len(context.args) < 2:
        await update.message.reply_text("Используйте: /reply <id> <текст>")
        return
    ticket_id = int(context.args[0])
    reply_text = " ".join(context.args[1:])
    ticket = await get_ticket(ticket_id)
    if not ticket:
        await update.message.reply_text("❌ Тикет не найден.")
        return
    await reply_ticket(ticket_id, reply_text, update.effective_user.id)
    try:
        await context.bot.send_message(chat_id=ticket[1], text=f"Ответ на обращение #{ticket_id}:\n{reply_text}")
    except:
        pass
    await update.message.reply_text("✅ Ответ отправлен.")

# ===== ЗАПУСК =====
async def main():
    await init_db()
    app = Application.builder().token(TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("admin", admin_panel))
    app.add_handler(CommandHandler("support", support_command))
    app.add_handler(CommandHandler("referral", referral_command))
    app.add_handler(CommandHandler("addadmin", addadmin))
    app.add_handler(CommandHandler("rmadmin", rmadmin))
    app.add_handler(CommandHandler("bladd", bladd))
    app.add_handler(CommandHandler("blrm", blrm))
    app.add_handler(CommandHandler("supportadd", supportadd))
    app.add_handler(CommandHandler("supportrm", supportrm))
    app.add_handler(CommandHandler("reply", reply_ticket_cmd))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    app.add_handler(CallbackQueryHandler(admin_callback, pattern="admin_"))

    print(f"{BOT_NAME} запущен (режим без имитации).")
    await app.run_polling()

if __name__ == "__main__":
    asyncio.run(main())
