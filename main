def save_cache_sync(query, results):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("REPLACE INTO cache (query, results, timestamp) VALUES (?, ?, ?)",
              (query, json.dumps(results), datetime.now().isoformat()))
    conn.commit()
    conn.close()

async def save_cache(query, results):
    await run_sync(save_cache_sync, query, results)

def get_cache_sync(query):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT results, timestamp FROM cache WHERE query=?", (query,))
    row = c.fetchone()
    conn.close()
    if row:
        timestamp = datetime.fromisoformat(row[1])
        if datetime.now() - timestamp < timedelta(hours=CACHE_TTL_HOURS):
            return json.loads(row[0])
    return None

async def get_cache(query):
    return await run_sync(get_cache_sync, query)

