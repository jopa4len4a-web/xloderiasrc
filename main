# ===== ЗАПУСК ================================================
# ============================================================
if __name__ == "__main__":
    init_db_sync()
    app = Application.builder().token(TOKEN).build()

    # Регистрация команд
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("admin", admin_panel))
    app.add_handler(CommandHandler("support", support_command))
    app.add_handler(CommandHandler("referral", referral_command))
    app.add_handler(CommandHandler("tickets", tickets_command))
    app.add_handler(CommandHandler("info", info_command))
    app.add_handler(CommandHandler("sources", sources_command))
    app.add_handler(CommandHandler("help", help_command))
    app.add_handler(CommandHandler("history", history_command))
    app.add_handler(CommandHandler("filter", filter_command))
    app.add_handler(CommandHandler("export", export_command))
    app.add_handler(CommandHandler("subscribe", subscribe_command))
    # Админ
    app.add_handler(CommandHandler("addadmin", addadmin))
    app.add_handler(CommandHandler("rmadmin", rmadmin))
    app.add_handler(CommandHandler("bladd", bladd))
    app.add_handler(CommandHandler("blrm", blrm))
    app.add_handler(CommandHandler("supportadd", supportadd))
    app.add_handler(CommandHandler("supportrm", supportrm))
    app.add_handler(CommandHandler("reply", reply_ticket_cmd))
    # Обработчики
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    app.add_handler(MessageHandler(filters.VOICE, voice_handler))
    app.add_handler(CallbackQueryHandler(admin_callback, pattern="admin_"))

    # Запуск мониторинга (в фоне)
    loop = asyncio.get_event_loop()
    loop.create_task(monitor_task(app))

    print(f"{BOT_NAME} 3.1 запущен с парсингом Doxbin.")
    app.run_polling()
