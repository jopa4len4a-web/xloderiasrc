    """Поиск пользователя по username (без @)."""
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT user_id, username FROM users WHERE username=?", (username,))
    row = c.fetchone()
    conn.close()
    return row

