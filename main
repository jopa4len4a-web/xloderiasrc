async def search_hibp(email: str) -> list:
    url = f"https://haveibeenpwned.com/api/v3/breachedaccount/{email}"
    headers = {"hibp-api-key": "", "User-Agent": "Xloderia/1.0"}
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, headers=headers, timeout=10) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    return [f"{b['Name']} ({b['BreachDate']}) — {', '.join(b['DataClasses'])}" for b in data]
                elif resp.status == 404:
                    return []
                else:
                    return []
        except:
            return []

async def search_scylla(query: str) -> list:
    url = "https://scylla.so/api/search"
    params = {"q": query, "size": 3}
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, params=params, timeout=10) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    results = data.get("results", [])
                    if results:
                        return [f"{r.get('source', 'unknown')}: {r.get('value', '')}" for r in results[:3]]
                return []
        except:
            return []

async def search_duckduckgo(query: str) -> list:
    url = f"https://html.duckduckgo.com/html/?q={query}"
    headers = {"User-Agent": "Mozilla/5.0"}
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, headers=headers, timeout=10) as resp:
                if resp.status == 200:
                    text = await resp.text()
                    soup = BeautifulSoup(text, "html.parser")
                    results = soup.find_all("a", class_="result__a")[:3]
                    if results:
                        return [f"DuckDuckGo: {r.get_text(strip=True)}" for r in results]
                return []
        except:
            return []

async def search_vk(query: str) -> list:
    return [f"Проверьте VK: https://vk.com/search?q={query}"]

async def search_pastebin(query: str) -> list:
    url = f"https://pastebin.com/search?q={query}"
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, timeout=10) as resp:
                if resp.status == 200:
                    # упрощённо
                    return [f"Найдено на Pastebin (проверьте вручную): https://pastebin.com/search?q={query}"]
                return []
        except:
            return []

async def search_doxbin(query: str) -> list:
    """Реальный парсинг doxbin.com"""
    url = f"https://doxbin.com/search?q={query}"
    headers = {"User-Agent": "Mozilla/5.0"}
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, headers=headers, timeout=10) as resp:
                if resp.status == 200:
                    text = await resp.text()
                    soup = BeautifulSoup(text, "html.parser")
                    # Ищем заголовки доксов (обычно h2 или a с классом)
                    items = soup.find_all("a", href=True)
                    results = []
                    for a in items:
                        if "/post/" in a.get('href', ''):
                            title = a.get_text(strip=True)
                            if title and len(title) > 3:
                                link = "https://doxbin.com" + a['href']
                                results.append(f"{title} -> {link}")
                    if results:
                        return results[:5]
                    else:
                        return [f"Ничего не найдено на Doxbin по запросу {query}"]
                else:
                    return [f"Ошибка доступа к Doxbin: {resp.status}"]
        except Exception as e:
            return [f"Ошибка парсинга Doxbin: {e}"]

async def search_leakcheck(query: str) -> list:
    url = f"https://leak-check.net/api/public?q={query}"
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, timeout=10) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("found"):
                        return [f"LeakCheck: {entry['type']}: {entry['value']}" for entry in data.get("results", [])]
                return []
        except:
            return []

async def search_telegram(query: str) -> list:
    return [f"Проверьте каналы: {', '.join(TELEGRAM_CHANNELS)}"]

async def search_leaklookup(query: str) -> list:
    if not LEAKLOOKUP_KEY:
        return []
    url = "https://leak-lookup.com/api/search"
    params = {"key": LEAKLOOKUP_KEY, "type": "email" if "@" in query else "username", "query": query}
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, params=params, timeout=10) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("success"):
                        return [f"{entry['source']}: {entry['value']}" for entry in data.get("results", [])[:3]]
                return []
        except:
            return []

async def search_breachdirectory(query: str) -> list:
    if not BREACHDIRECTORY_KEY:
        return []
    url = "https://breachdirectory.org/api/v1/search"
    params = {"key": BREACHDIRECTORY_KEY, "query": query}
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, params=params, timeout=10) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("found"):
                        return [f"{entry['source']}: {entry['value']}" for entry in data.get("results", [])[:3]]
                return []
        except:
            return []

async def search_niamonx(endpoint: str, query: str) -> list:
    if not NIAMONX_KEY:
        return []
    url = f"https://data-wells.niamonx.io/api/breach/{endpoint}"
    headers = {"Authorization": f"Bearer {NIAMONX_KEY}"}
    params = {"q": query}
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, headers=headers, params=params, timeout=10) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    if data.get("results"):
                        return [f"{r.get('type', '')}: {r.get('value', '')}" for r in data["results"][:3]]
                return []
        except:
            return []

# ===== ОСНОВНАЯ ФУНКЦИЯ ПОИСКА =====
async def search_all(query: str) -> dict:
    query = query.strip()
    if await is_blacklisted(query):
        return {"error": "⛔ Данные скрыты администратором"}

    cached = await get_cache(query)
    if cached:
        return cached

    results = {}
    tasks = [
        ("Have I Been Pwned", search_hibp(query)),
        ("Scylla.so", search_scylla(query)),
        ("DuckDuckGo", search_duckduckgo(query)),
        ("VK (ссылка)", search_vk(query)),
        ("Pastebin", search_pastebin(query)),
        ("Doxbin", search_doxbin(query)),
        ("LeakCheck", search_leakcheck(query)),
        ("Telegram", search_telegram(query))
    ]
    if LEAKLOOKUP_KEY:
        tasks.append(("Leak-Lookup", search_leaklookup(query)))
    if BREACHDIRECTORY_KEY:
        tasks.append(("BreachDirectory", search_breachdirectory(query)))
    if NIAMONX_KEY:
        endpoints = ["QZaem-sample", "I-GIS", "2GIS-2025", "Azur.ru", "NeedSpec.ru",
                     "torlog", "podrygka", "bdu", "leakcheck", "himera",
                     "leakosint", "dyxless", "gta", "opendata", "getairplane"]
        for ep in endpoints:
            tasks.append((f"NiamonX-{ep}", search_niamonx(ep, query)))

    for name, coro in tasks:
        res = await coro
        if res:
            results[name] = res

    if results:
        await save_cache(query, results)
    return results

# ===== УМНЫЙ ПОИСК (fuzzy) =====
async def fuzzy_search(query: str) -> dict:
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT query FROM cache")
    rows = c.fetchall()
    conn.close()
    best_matches = []
    for (q,) in rows:
        ratio = fuzz.ratio(query.lower(), q.lower())
        if ratio > 70:
            best_matches.append((q, ratio))
    best_matches.sort(key=lambda x: x[1], reverse=True)
    if best_matches:
        best_query = best_matches[0][0]
        cached = await get_cache(best_query)
        if cached:
            return cached
    return {}

