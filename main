async def start(update: Update, context):
    user = update.effective_user
    await register_user(user.id, user.username, user.first_name, user.last_name)
    if context.args:
        code = context.args[0]
        owner = await get_referral_owner(code)
        if owner:
            await use_referral(code, user.id)
            await update.message.reply_text("✅ Реферальный код активирован!")
    await update.message.reply_text(
        f"🔍 {BOT_NAME} 3.1 — поиск по реальным источникам, включая Doxbin.\n"
        f"Отправьте email, телефон, username или ФИО.\n"
        f"Команды: /admin, /support, /referral, /tickets, /history, /filter, /export, /subscribe",
        reply_markup=get_main_keyboard()
    )

async def info_command(update: Update, context):
    text = (
        "ℹ️ *О боте Xloderia*\n\n"
