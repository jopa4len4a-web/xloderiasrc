async def search_all(query: str) -> dict:
    results = {}
    results["QZaem"] = await search_qzaem(query)
    results["I-GIS"] = await search_igis(query)
    results["2GIS"] = await search_2gis(query)
    results["Azur.ru"] = await search_azur(query)
    results["NeedSpec.ru"] = await search_needspec(query)
    results["TOR_LOG RU"] = await search_torlog(query)
    results["Podrygka"] = await search_podrygka(query)
    results["БДУ ФСТЭК"] = await search_bdu(query)
    results["LeakCheck"] = await search_leakcheck(query)
    results["Himera Search"] = await search_himera(query)
    results["LeakOsint"] = await search_leakosint(query)
    results["Dyxless"] = await search_dyxless(query)
    results["Gta Search"] = await search_gta(query)
    results["OpenDataUA"] = await search_opendata(query)
    results["getairplane"] = await search_getairplane(query)
    return results

# ======= ГЕНЕРАЦИЯ =======
def generate_fake(query: str) -> dict:
    return {
        "телефон": f"+7{random.randint(900, 999)}{random.randint(1000000, 9999999)}",
        "адрес": f"ул. {random.choice(['Ленина', 'Пушкина', 'Гагарина'])}, {random.randint(1, 150)}",
        "дата рождения": f"{random.randint(1, 28)}.{random.randint(1, 12)}.{random.randint(1970, 2005)}",
        "соцсети": f"vk.com/id{random.randint(100000, 999999)}",
        "email": f"{query.lower().replace(' ', '')}{random.randint(1, 99)}@mail.ru"
    }

# ======= ОБРАБОТЧИКИ =======
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        f"Я — {BOT_NAME}. 15 российских БД вшито.\n"
        "Отправь email, телефон, username или ФИО.",
        reply_markup=get_keyboard()
    )

async def info(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = (
        "ℹ️ *О боте Xloderia*\n\n"
        "Бот полностью легален. Все данные из открытых источников.\n"
        "Владелец не несёт ответственности за использование информации.\n"
        "Используйте только в законных целях."
    )
    await update.message.reply_text(text, parse_mode="Markdown", reply_markup=get_keyboard())

async def sources(update: Update, context: ContextTypes.DEFAULT_TYPE):
    lines = ["📂 *15 российских БД:*"]
    for src in SOURCES:
        lines.append(f"• {src}")
    await update.message.reply_text("\n".join(lines), parse_mode="Markdown", reply_markup=get_keyboard())

async def help_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = "Отправь email, телефон, username или ФИО — бот проверит по 15 БД."
    await update.message.reply_text(text, parse_mode="Markdown", reply_markup=get_keyboard())

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text
    if text in ["📋 Инфо о боте", "/info"]:
        await info(update, context)
        return
    if text in ["📂 Источники", "/sources"]:
        await sources(update, context)
        return
    if text in ["❓ Помощь", "/help"]:
        await help_cmd(update, context)
        return

    query = text.strip()
    if not query:
        await update.message.reply_text("Введите что-нибудь.", reply_markup=get_keyboard())
        return

    await update.message.reply_text(f"🔍 Поиск по 15 БД: {query}...", reply_markup=get_keyboard())

    results = await search_all(query)
    output = []
    found = False
    for src, entries in results.items():
        if entries:
            output.append(f"=== {src} ===")
            output.extend(entries)
            found = True

    if not found:
        output.append("Ничего не найдено.")
        fake = generate_fake(query)
        output.append("\n=== Сгенерировано ===")
        for k, v in fake.items():
            output.append(f"{k}: {v}")

    await update.message.reply_text("\n".join(output)[:4000], reply_markup=get_keyboard())

# ======= ЗАПУСК =======
def main():
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("info", info))
    app.add_handler(CommandHandler("sources", sources))
    app.add_handler(CommandHandler("help", help_cmd))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    print(f"{BOT_NAME} запущен с 15 российскими БД.")
    app.run_polling()

if __name__ == "__main__":
    main()
