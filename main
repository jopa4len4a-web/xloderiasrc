async def my_tickets_command(update: Update, context):
    user_id = update.effective_user.id
    tickets = await get_user_tickets(user_id)
    if not tickets:
        await update.message.reply_text("У вас нет обращений.")
        return
    msg = "📩 Ваши тикеты:\n"
    for t in tickets:
        status = t[2]
        reply = t[3] if t[3] else "ожидает ответа"
        msg += f"#{t[0]} [{status}]: {t[1][:30]}...\n   Ответ: {reply}\n"
    await update.message.reply_text(msg[:4000])

# ===== АДМИН-ПАНЕЛЬ =====
async def admin_panel(update: Update, context):
    if not await is_admin(update.effective_user.id):
        await update.message.reply_text("⛔ Только для админов.", reply_markup=get_main_keyboard())
        return
    keyboard = [
        [InlineKeyboardButton("👥 Добавить админа", callback_data="admin_add")],
        [InlineKeyboardButton("🗑 Удалить админа", callback_data="admin_remove")],
        [InlineKeyboardButton("⛔ Добавить в чёрный список", callback_data="blacklist_add")],
        [InlineKeyboardButton("✅ Удалить из чёрного списка", callback_data="blacklist_remove")],
        [InlineKeyboardButton("🎫 Назначить техподдержку", callback_data="support_add")],
        [InlineKeyboardButton("❌ Снять техподдержку", callback_data="support_remove")],
        [InlineKeyboardButton("📩 Тикеты поддержки", callback_data="support_tickets")],
        [InlineKeyboardButton("📊 Статистика", callback_data="stats")],
        [InlineKeyboardButton("❓ Помощь по админке", callback_data="admin_help")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    await update.message.reply_text("🛠 Админ-панель", reply_markup=reply_markup)

async def admin_callback(update: Update, context):
    query = update.callback_query
    await query.answer()
    data = query.data
    user_id = update.effective_user.id

    if not await is_admin(user_id):
        await query.edit_message_text("⛔ Доступ запрещён.")
        return

    if data == "admin_add":
        await query.edit_message_text("Используйте команду: `/addadmin <ID>`", parse_mode="Markdown")
    elif data == "admin_remove":
        await query.edit_message_text("Используйте команду: `/rmadmin <ID>`", parse_mode="Markdown")
    elif data == "blacklist_add":
        await query.edit_message_text("Используйте команду: `/bladd <ФИО/телефон/email>`", parse_mode="Markdown")
    elif data == "blacklist_remove":
        await query.edit_message_text("Используйте команду: `/blrm <ФИО/телефон/email>`", parse_mode="Markdown")
    elif data == "support_add":
        await query.edit_message_text("Используйте команду: `/supportadd <ID>`", parse_mode="Markdown")
    elif data == "support_remove":
        await query.edit_message_text("Используйте команду: `/supportrm <ID>`", parse_mode="Markdown")
    elif data == "support_tickets":
        tickets = await get_open_tickets()
        if not tickets:
            await query.edit_message_text("📭 Нет открытых тикетов.")
            return
        msg = "📩 Открытые тикеты:\n"
        for t in tickets:
            msg += f"#{t[0]} от {t[1]} ({t[3]}): {t[2][:50]}...\n"
        msg += "\nЧтобы ответить: `/reply <id> <текст>`"
        await query.edit_message_text(msg, parse_mode="Markdown")
    elif data == "stats":
        users, bl, tickets = await run_sync(get_stats_sync)
        await query.edit_message_text(
            f"📊 *Статистика*\n👤 Пользователей: {users}\n⛔ В чёрном списке: {bl}\n📩 Открытых тикетов: {tickets}",
            parse_mode="Markdown"
        )
    elif data == "admin_help":
        help_text = (
            "📖 *Помощь по админке*\n\n"
            "Команды:\n"
            "`/addadmin <ID>` – добавить админа\n"
            "`/rmadmin <ID>` – удалить админа\n"
            "`/bladd <текст>` – добавить в чёрный список\n"
            "`/blrm <текст>` – удалить из чёрного\n"
            "`/supportadd <ID>` – назначить техподдержку\n"
            "`/supportrm <ID>` – снять техподдержку\n"
            "`/reply <ID> <текст>` – ответить на тикет\n\n"
            "Чёрный список блокирует выдачу данных по запросу.\n"
            "Техподдержка может отвечать на тикеты.\n\n"
            "Активные источники: HIBP, Scylla, DuckDuckGo, VK, Pastebin, Doxbin, LeakCheck, Telegram, Leak-Lookup (ключ), BreachDirectory (ключ), NiamonX (ключ)."
        )
        await query.edit_message_text(help_text, parse_mode="Markdown")

# ===== ТЕХПОДДЕРЖКА =====
async def support_command(update: Update, context):
    user_id = update.effective_user.id
    text = update.message.text
    if len(text) <= 8:
        await update.message.reply_text("Напишите /support <ваше сообщение>")
        return
    msg = text[9:].strip()
    if not msg:
        await update.message.reply_text("Сообщение не может быть пустым.")
        return
    await create_ticket(user_id, msg)
    await update.message.reply_text("✅ Обращение создано. Ожидайте ответа.", reply_markup=get_main_keyboard())

async def tickets_command(update: Update, context):
    user_id = update.effective_user.id
    if not await is_admin(user_id) and not await is_support(user_id):
        await update.message.reply_text("⛔ Доступно только для админов и техподдержки.", reply_markup=get_main_keyboard())
        return
    tickets = await get_open_tickets()
    if not tickets:
        await update.message.reply_text("📭 Нет открытых тикетов.", reply_markup=get_main_keyboard())
        return
    msg = "📩 Открытые тикеты:\n"
    for t in tickets:
        msg += f"#{t[0]} от {t[1]} ({t[3]}): {t[2][:50]}...\n"
    msg += "\nЧтобы ответить: `/reply <id> <текст>`"
    await update.message.reply_text(msg, parse_mode="Markdown", reply_markup=get_main_keyboard())

async def referral_command(update: Update, context):
    user_id = update.effective_user.id
    code = await generate_referral_code(user_id)
    await update.message.reply_text(f"Ваша реферальная ссылка:\n`/start {code}`", parse_mode="Markdown", reply_markup=get_main_keyboard())

# ===== НОВЫЕ КОМАНДЫ =====
async def history_command(update: Update, context):
    user_id = update.effective_user.id
    history = await get_history(user_id)
    if not history:
        await update.message.reply_text("История поиска пуста.")
        return
    msg = "📜 *История поиска:*\n"
    for i, (query, _, timestamp) in enumerate(history, 1):
        msg += f"{i}. {query} ({timestamp})\n"
    await update.message.reply_text(msg, parse_mode="Markdown", reply_markup=get_main_keyboard())

async def filter_command(update: Update, context):
    user_id = update.effective_user.id
    if context.args:
        filter_type = context.args[0].lower()
        if filter_type in ['all', 'email', 'phone', 'name']:
            await set_filter(user_id, filter_type)
            await update.message.reply_text(f"✅ Фильтр установлен: {filter_type}")
        else:
            await update.message.reply_text("❌ Неверный тип. Используйте: all, email, phone, name")
    else:
        current = await get_filter(user_id)
        await update.message.reply_text(f"Текущий фильтр: {current}")

async def export_command(update: Update, context):
    history = await get_history(update.effective_user.id, 1)
    if not history:
        await update.message.reply_text("Нет результатов для экспорта.")
        return
    query, results_json, _ = history[0]
    results = json.loads(results_json)
    if not results:
        await update.message.reply_text("Нет данных.")
        return
    text = f"Результаты поиска по запросу: {query}\n\n"
    for src, entries in results.items():
        text += f"📌 {src}:\n"
        for e in entries:
            text += f"   • {e}\n"
        text += "\n"
    with open("export.txt", "w", encoding="utf-8") as f:
        f.write(text)
    await update.message.reply_document(document=open("export.txt", "rb"), filename="export.txt")

async def subscribe_command(update: Update, context):
    user_id = update.effective_user.id
    if context.args:
        query = " ".join(context.args)
        await add_subscription(user_id, query)
        await update.message.reply_text(f"✅ Вы подписались на мониторинг запроса: {query}")
    else:
        await update.message.reply_text("Используйте: /subscribe <запрос>")

# ===== ГОЛОСОВОЙ ВВОД (заглушка) =====
async def voice_handler(update: Update, context):
    await update.message.reply_text("Голосовой ввод требует настройки (ключ Google Speech). Пока не реализован.")

# ===== ОБРАБОТЧИК СООБЩЕНИЙ =====
async def handle_message(update: Update, context):
    text = update.message.text
    if not text:
        return

    # Кнопки меню
    if text == "📋 Инфо о боте":
        await info_command(update, context)
        return
    elif text == "📂 Источники":
        await sources_command(update, context)
        return
    elif text == "❓ Помощь":
        await help_command(update, context)
        return
    elif text == "📩 Мои тикеты":
        await my_tickets_command(update, context)
        return

    if text.startswith('/'):
        return

    # Поиск
    user_id = update.effective_user.id
    filter_type = await get_filter(user_id)

    results = await search_all(text)
    if "error" in results:
        await update.message.reply_text(results["error"], reply_markup=get_main_keyboard())
        return

    if not results:
        results = await fuzzy_search(text)
        if results:
            await update.message.reply_text("🔍 Найдено похожее (умный поиск):", reply_markup=get_main_keyboard())
        else:
            await update.message.reply_text("❌ Ничего не найдено.", reply_markup=get_main_keyboard())
            return

    # Фильтрация
    if filter_type != 'all':
        filtered = {}
        for src, entries in results.items():
            filtered_entries = []
            for e in entries:
                if filter_type == 'email' and '@' in e:
                    filtered_entries.append(e)
                elif filter_type == 'phone' and re.search(r'\+?\d{10,15}', e):
                    filtered_entries.append(e)
                elif filter_type == 'name' and re.search(r'[А-Яа-я]+\s+[А-Яа-я]+', e):
                    filtered_entries.append(e)
                elif filter_type == 'all':
                    filtered_entries.append(e)
            if filtered_entries:
                filtered[src] = filtered_entries
        results = filtered

    if not results:
        await update.message.reply_text("❌ После фильтрации ничего не найдено.", reply_markup=get_main_keyboard())
        return

    await save_history(user_id, text, results)

    output = []
    for src, entries in results.items():
        output.append(f"📌 {src} (источник: {src}):")
        for e in entries:
            output.append(f"   • {e}")
        output.append("")
    reply = "\n".join(output)
    if len(reply) > 4096:
        reply = reply[:4093] + "..."
    await update.message.reply_text(reply, reply_markup=get_main_keyboard())

# ===== АДМИН-КОМАНДЫ =====
async def addadmin(update, context):
    if not await is_admin(update.effective_user.id): return
    if not context.args: return
    target = int(context.args[0])
    await add_admin(target)
    await update.message.reply_text(f"✅ Пользователь {target} стал админом.", reply_markup=get_main_keyboard())

async def rmadmin(update, context):
    if not await is_admin(update.effective_user.id): return
    if not context.args: return
    target = int(context.args[0])
    if await remove_admin(target):
        await update.message.reply_text(f"✅ Админ {target} снят.", reply_markup=get_main_keyboard())
    else:
        await update.message.reply_text("❌ Нельзя удалить последнего админа.", reply_markup=get_main_keyboard())

async def bladd(update, context):
    if not await is_admin(update.effective_user.id): return
    if not context.args: return
    pattern = " ".join(context.args)
    if await add_blacklist(pattern, update.effective_user.id):
        await update.message.reply_text(f"✅ Добавлено в чёрный список: {pattern}", reply_markup=get_main_keyboard())
    else:
        await update.message.reply_text("❌ Ошибка (возможно уже есть).", reply_markup=get_main_keyboard())

async def blrm(update, context):
    if not await is_admin(update.effective_user.id): return
    if not context.args: return
    pattern = " ".join(context.args)
    await remove_blacklist(pattern)
    await update.message.reply_text(f"✅ Удалено из чёрного списка: {pattern}", reply_markup=get_main_keyboard())

async def supportadd(update, context):
    if not await is_admin(update.effective_user.id): return
    if not context.args: return
    target = int(context.args[0])
    await set_support(target)
    await update.message.reply_text(f"✅ Пользователь {target} назначен техподдержкой.", reply_markup=get_main_keyboard())

async def supportrm(update, context):
    if not await is_admin(update.effective_user.id): return
    if not context.args: return
    target = int(context.args[0])
    await remove_support(target)
    await update.message.reply_text(f"✅ Техподдержка снята с {target}.", reply_markup=get_main_keyboard())

async def reply_ticket_cmd(update, context):
    if not await is_admin(update.effective_user.id) and not await is_support(update.effective_user.id):
        return
    if len(context.args) < 2:
        await update.message.reply_text("Используйте: /reply <id> <текст>")
        return
    ticket_id = int(context.args[0])
    reply_text = " ".join(context.args[1:])
    ticket = await get_ticket(ticket_id)
    if not ticket:
        await update.message.reply_text("❌ Тикет не найден.")
        return
    await reply_ticket(ticket_id, reply_text, update.effective_user.id)
    try:
        await context.bot.send_message(chat_id=ticket[1], text=f"Ответ на обращение #{ticket_id}:\n{reply_text}")
    except:
        pass
    await update.message.reply_text("✅ Ответ отправлен.", reply_markup=get_main_keyboard())

# ===== ФОНОВЫЙ МОНИТОРИНГ =====
async def monitor_task(application):
    while True:
        await asyncio.sleep(86400)
        subscriptions = await get_subscriptions()
        for user_id, query in subscriptions:
            results = await search_all(query)
            if results and "error" not in results:
                try:
                    await application.bot.send_message(
                        chat_id=user_id,
                        text=f"🔔 Новые данные по запросу '{query}':\n{json.dumps(results, indent=2, ensure_ascii=False)[:1000]}"
                    )
                except:
                    pass

