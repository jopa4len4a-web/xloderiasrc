def remove_admin_sync(admin_id):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT COUNT(*) FROM users WHERE role='admin'")
    count = c.fetchone()[0]
    if count <= 1:
        conn.close()
        return False
    c.execute("UPDATE users SET role='user' WHERE user_id=?", (admin_id,))
    conn.commit()
    conn.close()
    return True

