# ===== ИНИЦИАЛИЗАЦИЯ БД =====
async def init_db():
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute('''
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                first_name TEXT,
                last_name TEXT,
                registered_at TEXT,
                referred_by INTEGER,
                role TEXT DEFAULT 'user'  -- admin, support, user
            )
        ''')
        await db.execute('''
            CREATE TABLE IF NOT EXISTS blacklist (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                pattern TEXT UNIQUE,  -- может быть ФИО, телефон, email
                added_by INTEGER,
                added_at TEXT
            )
        ''')
        await db.execute('''
            CREATE TABLE IF NOT EXISTS support_tickets (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                message TEXT,
                status TEXT DEFAULT 'open',  -- open, in_progress, closed
                created_at TEXT,
                assigned_to INTEGER,
                reply TEXT
            )
        ''')
        await db.execute('''
            CREATE TABLE IF NOT EXISTS referrals (
                referral_code TEXT PRIMARY KEY,
                owner_id INTEGER,
                used_by INTEGER,
                used_at TEXT
            )
        ''')
        await db.commit()

        # Если нет админов — сделать первого зарегистрированного админом (позже)
        cursor = await db.execute("SELECT COUNT(*) FROM users WHERE role='admin'")
        count = await cursor.fetchone()
        if count[0] == 0:
            # Админом станет первый, кто запустит /start (установим в обработчике)
            pass

# ===== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ БД =====
async def get_user(user_id):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT * FROM users WHERE user_id=?", (user_id,))
        return await cursor.fetchone()

async def register_user(user_id, username, first_name, last_name, referred_by=None):
    async with aiosqlite.connect(DB_PATH) as db:
        # Проверяем, есть ли уже
        cursor = await db.execute("SELECT user_id FROM users WHERE user_id=?", (user_id,))
        if await cursor.fetchone():
            return
        # Первый пользователь становится админом
        cursor = await db.execute("SELECT COUNT(*) FROM users")
        count = await cursor.fetchone()
        role = 'admin' if count[0] == 0 else 'user'
        await db.execute(
            "INSERT INTO users (user_id, username, first_name, last_name, registered_at, referred_by, role) VALUES (?, ?, ?, ?, ?, ?, ?)",
            (user_id, username, first_name, last_name, datetime.now().isoformat(), referred_by, role)
        )
        await db.commit()

async def is_admin(user_id):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT role FROM users WHERE user_id=?", (user_id,))
        row = await cursor.fetchone()
        return row and row[0] == 'admin'

async def is_support(user_id):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT role FROM users WHERE user_id=?", (user_id,))
        row = await cursor.fetchone()
        return row and row[0] == 'support'

async def add_admin(user_id, admin_id):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE users SET role='admin' WHERE user_id=?", (admin_id,))
        await db.commit()

async def remove_admin(user_id, admin_id):
    async with aiosqlite.connect(DB_PATH) as db:
        # Нельзя удалить последнего админа
        cursor = await db.execute("SELECT COUNT(*) FROM users WHERE role='admin'")
        count = await cursor.fetchone()
        if count[0] <= 1:
            return False
        await db.execute("UPDATE users SET role='user' WHERE user_id=?", (admin_id,))
        await db.commit()
        return True

async def set_support(user_id, target_id):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE users SET role='support' WHERE user_id=?", (target_id,))
        await db.commit()

async def remove_support(user_id, target_id):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE users SET role='user' WHERE user_id=?", (target_id,))
        await db.commit()

async def add_blacklist(admin_id, pattern):
    async with aiosqlite.connect(DB_PATH) as db:
        try:
            await db.execute("INSERT INTO blacklist (pattern, added_by, added_at) VALUES (?, ?, ?)",
                             (pattern, admin_id, datetime.now().isoformat()))
            await db.commit()
            return True
        except:
            return False

async def remove_blacklist(admin_id, pattern):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("DELETE FROM blacklist WHERE pattern=?", (pattern,))
        await db.commit()
        return True

async def is_blacklisted(pattern):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT pattern FROM blacklist WHERE pattern=?", (pattern,))
        return await cursor.fetchone() is not None

async def create_ticket(user_id, message):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute(
            "INSERT INTO support_tickets (user_id, message, created_at, status) VALUES (?, ?, ?, 'open')",
            (user_id, message, datetime.now().isoformat())
        )
        await db.commit()

async def get_open_tickets():
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT id, user_id, message, created_at FROM support_tickets WHERE status='open' OR status='in_progress'")
        return await cursor.fetchall()

async def get_ticket(ticket_id):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT * FROM support_tickets WHERE id=?", (ticket_id,))
        return await cursor.fetchone()

async def reply_ticket(ticket_id, reply_text, support_id):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE support_tickets SET reply=?, status='closed', assigned_to=? WHERE id=?",
                         (reply_text, support_id, ticket_id))
        await db.commit()

async def get_user_tickets(user_id):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT id, message, status, reply FROM support_tickets WHERE user_id=?", (user_id,))
        return await cursor.fetchall()

async def generate_referral_code(user_id):
    code = f"REF{random.randint(100000, 999999)}"
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("INSERT INTO referrals (referral_code, owner_id) VALUES (?, ?)", (code, user_id))
        await db.commit()
    return code

async def get_referral_owner(code):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT owner_id FROM referrals WHERE referral_code=?", (code,))
        row = await cursor.fetchone()
        return row[0] if row else None

async def use_referral(code, user_id):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE referrals SET used_by=?, used_at=? WHERE referral_code=?",
                         (user_id, datetime.now().isoformat(), code))
        await db.commit()

