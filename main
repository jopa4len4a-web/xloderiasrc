async def start_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    text = (
        f"🔍 *Xloderia 4.6*\n"
        "═══════════════════\n"
        "Я ищу информацию в открытых источниках.\n"
        "Отправь email, телефон или ФИО — я проверю.\n"
        "Навигация через кнопки ниже.\n"
        "═══════════════════\n"
        "❗ Используй бота только в законных целях."
    )
    await update.message.reply_text(text, parse_mode="Markdown", reply_markup=await get_main_keyboard(user.id))

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    text = update.message.text
    if not text:
        return

    # Обработка состояний (ввод данных для админки и тикетов)
    if user_id in user_states:
        state = user_states[user_id]
        action = state['action']
        if action == 'awaiting_admin_add':
            username = text.strip().lstrip('@')
            user_data = await get_user_by_username(username)
            if user_data:
                target_id = user_data[0]
                await add_admin(target_id)
                await update.message.reply_text(f"✅ Пользователь @{username} стал админом.", reply_markup=await get_main_keyboard(user_id))
            else:
                await update.message.reply_text("❌ Пользователь с таким username не найден.", reply_markup=await get_main_keyboard(user_id))
            del user_states[user_id]
            return
        elif action == 'awaiting_admin_remove':
            username = text.strip().lstrip('@')
            user_data = await get_user_by_username(username)
            if user_data:
                target_id = user_data[0]
                if await remove_admin(target_id):
                    await update.message.reply_text(f"✅ Админ @{username} снят.", reply_markup=await get_main_keyboard(user_id))
                else:
                    await update.message.reply_text("❌ Нельзя удалить последнего админа.", reply_markup=await get_main_keyboard(user_id))
            else:
                await update.message.reply_text("❌ Пользователь не найден.", reply_markup=await get_main_keyboard(user_id))
            del user_states[user_id]
            return
        elif action == 'awaiting_blacklist_add':
            pattern = text.strip()
            if await add_blacklist(pattern, user_id):
                await update.message.reply_text(f"✅ Добавлено в чёрный список: {pattern}", reply_markup=await get_main_keyboard(user_id))
            else:
                await update.message.reply_text("❌ Ошибка (возможно уже есть).", reply_markup=await get_main_keyboard(user_id))
            del user_states[user_id]
            return
        elif action == 'awaiting_blacklist_remove':
            pattern = text.strip()
            await remove_blacklist(pattern)
            await update.message.reply_text(f"✅ Удалено из чёрного списка: {pattern}", reply_markup=await get_main_keyboard(user_id))
            del user_states[user_id]
            return
        elif action == 'awaiting_support_add':
            username = text.strip().lstrip('@')
            user_data = await get_user_by_username(username)
            if user_data:
                target_id = user_data[0]
                await set_support(target_id)
                await update.message.reply_text(f"✅ Пользователь @{username} назначен техподдержкой.", reply_markup=await get_main_keyboard(user_id))
            else:
                await update.message.reply_text("❌ Пользователь не найден.", reply_markup=await get_main_keyboard(user_id))
            del user_states[user_id]
            return
        elif action == 'awaiting_support_remove':
            username = text.strip().lstrip('@')
            user_data = await get_user_by_username(username)
            if user_data:
                target_id = user_data[0]
                await remove_support(target_id)
                await update.message.reply_text(f"✅ Техподдержка снята с @{username}.", reply_markup=await get_main_keyboard(user_id))
            else:
                await update.message.reply_text("❌ Пользователь не найден.", reply_markup=await get_main_keyboard(user_id))
            del user_states[user_id]
            return
        elif action == 'awaiting_ticket_reply':
            ticket_id = state['ticket_id']
            reply_text = text.strip()
            if reply_text:
                await reply_ticket(ticket_id, reply_text, user_id)
                ticket = await get_ticket(ticket_id)
                if ticket:
                    try:
                        await context.bot.send_message(chat_id=ticket[1], text=f"Ответ на обращение #{ticket_id}:\n{reply_text}")
                    except:
                        pass
                await update.message.reply_text(f"✅ Ответ на тикет #{ticket_id} отправлен.", reply_markup=await get_main_keyboard(user_id))
            else:
                await update.message.reply_text("❌ Сообщение не может быть пустым.", reply_markup=await get_main_keyboard(user_id))
            del user_states[user_id]
            return
        elif action == 'awaiting_ticket_creation':
            msg_text = text.strip()
            if msg_text:
                await create_ticket(user_id, msg_text)
                await update.message.reply_text("✅ Ваше обращение создано. Ожидайте ответа.", reply_markup=await get_main_keyboard(user_id))
            else:
                await update.message.reply_text("❌ Сообщение не может быть пустым.", reply_markup=await get_main_keyboard(user_id))
            del user_states[user_id]
            return
        else:
            del user_states[user_id]

    # Регистрация нового пользователя
    is_new = await register_user(user_id, update.effective_user.username,
                                 update.effective_user.first_name, update.effective_user.last_name)
    if is_new:
        await start_message(update, context)
        return

    # Кнопки
    if text == "📋 Инфо о боте":
        await info_command(update, context)
    elif text == "📊 Статус":
        await status_command(update, context)
    elif text == "❓ Помощь":
        await help_command(update, context)
    elif text == "📩 Мои тикеты":
        await my_tickets_command(update, context)
    elif text == "📝 Создать тикет":
        user_states[user_id] = {'action': 'awaiting_ticket_creation'}
        await update.message.reply_text("✍️ Напишите текст вашего обращения в поддержку:")
    elif text == "📜 История":
        await history_command(update, context)
    elif text == "⚙️ Настройки":
        await settings_command(update, context)
    elif text == "📤 Экспорт":
        await export_command(update, context)
    elif text == "🔔 Подписка":
        await subscribe_command(update, context)
    elif text == "🛠 Админ-панель":
        if await is_admin(user_id):
            await admin_panel(update, context)
        else:
            await update.message.reply_text("⛔ Доступ запрещён.", reply_markup=await get_main_keyboard(user_id))
    else:
        await perform_search(update, context, text)

# ---- Обработчики (все текстовые, без картинок) ----
async def info_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    text = (
        "ℹ️ *О боте Xloderia*\n\n"
        "Бот ищет информацию в открытых источниках и базах утечек.\n"
        "Все данные получены из легальных API и парсинга.\n"
        "Владелец не несёт ответственности за использование полученной информации.\n"
        "Используйте бота только в законных целях."
    )
    await update.message.reply_text(text, parse_mode="Markdown", reply_markup=await get_main_keyboard(user_id))

async def status_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    uptime = int((datetime.now() - start_time).total_seconds())
    h = uptime // 3600
    m = (uptime % 3600) // 60
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT COUNT(*) FROM users")
    users = c.fetchone()[0]
    c.execute("SELECT COUNT(*) FROM cache")
    cache_count = c.fetchone()[0]
    c.execute("SELECT COUNT(*) FROM subscriptions")
    subs = c.fetchone()[0]
    conn.close()
    text = (
        f"📊 *Статус бота*\n"
        f"⏱ Время работы: {h}ч {m}м\n"
        f"👤 Пользователей: {users}\n"
        f"💾 Кэш: {cache_count} записей\n"
        f"🔔 Подписок: {subs}"
    )
    await update.message.reply_text(text, parse_mode="Markdown", reply_markup=await get_main_keyboard(user_id))

async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    text = (
        "❓ *Помощь*\n\n"
        "Отправьте любой текст — бот попытается найти информацию.\n"
        "Кнопки:\n"
        "• 📋 Инфо о боте – общая информация\n"
        "• 📊 Статус – техническая статистика\n"
        "• ❓ Помощь – эта справка\n"
        "• 📩 Мои тикеты – ваши обращения в поддержку\n"
        "• 📝 Создать тикет – новое обращение\n"
        "• 📜 История – последние 10 запросов\n"
        "• ⚙️ Настройки – смена фильтра (email/phone/name/all)\n"
        "• 📤 Экспорт – выгрузка последнего результата в файл\n"
        "• 🔔 Подписка – подписка на мониторинг запроса\n"
        "• 🛠 Админ-панель – только для администратора"
    )
    await update.message.reply_text(text, parse_mode="Markdown", reply_markup=await get_main_keyboard(user_id))

async def my_tickets_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    tickets = await get_user_tickets(user_id)
    if not tickets:
        await update.message.reply_text("У вас нет обращений.", reply_markup=await get_main_keyboard(user_id))
        return
    msg = "📩 Ваши тикеты:\n"
    for t in tickets:
        status = t[2]
        reply = t[3] if t[3] else "ожидает ответа"
        msg += f"#{t[0]} [{status}]: {t[1][:30]}...\n   Ответ: {reply}\n"
    await update.message.reply_text(msg[:4000], reply_markup=await get_main_keyboard(user_id))

async def history_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    history = await get_history(user_id)
    if not history:
        await update.message.reply_text("История поиска пуста.", reply_markup=await get_main_keyboard(user_id))
        return
    msg = "📜 *История поиска:*\n"
    for i, (query, _, timestamp) in enumerate(history, 1):
        msg += f"{i}. {query} ({timestamp})\n"
    await update.message.reply_text(msg, parse_mode="Markdown", reply_markup=await get_main_keyboard(user_id))

async def settings_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    current = await get_filter(user_id)
    text = (
        f"⚙️ *Настройки фильтра*\n\n"
        f"Текущий фильтр: `{current}`\n\n"
        "Выберите новый фильтр, отправив команду в чат:\n"
        "• `filter all` – отключить фильтр\n"
        "• `filter email` – показывать только email\n"
        "• `filter phone` – показывать только телефоны\n"
        "• `filter name` – показывать только ФИО\n\n"
        "Просто напишите в чат, например: `filter phone`"
    )
    await update.message.reply_text(text, parse_mode="Markdown", reply_markup=await get_main_keyboard(user_id))

async def export_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    history = await get_history(user_id, 1)
    if not history:
        await update.message.reply_text("Нет результатов для экспорта.", reply_markup=await get_main_keyboard(user_id))
        return
    query, results_json, _ = history[0]
    results = json.loads(results_json)
    if not results:
        await update.message.reply_text("Нет данных.", reply_markup=await get_main_keyboard(user_id))
        return
    text = f"Результаты поиска по запросу: {query}\n\n"
    for src, entries in results.items():
        text += f"📌 {src}:\n"
        for e in entries:
            text += f"   • {e}\n"
        text += "\n"
    with open("export.txt", "w", encoding="utf-8") as f:
        f.write(text)
    await update.message.reply_document(document=open("export.txt", "rb"), filename="export.txt", reply_markup=await get_main_keyboard(user_id))

async def subscribe_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    text = (
        "🔔 *Подписка на мониторинг*\n\n"
        "Чтобы подписаться на обновления по запросу, отправьте в чат:\n"
        "`subscribe <запрос>`\n\n"
        "Например: `subscribe Иванов Иван`\n"
        "Бот будет раз в сутки проверять новые данные и присылать уведомления."
    )
    await update.message.reply_text(text, parse_mode="Markdown", reply_markup=await get_main_keyboard(user_id))

# ---- Поиск ----
async def perform_search(update: Update, context: ContextTypes.DEFAULT_TYPE, query: str):
    user_id = update.effective_user.id
    filter_type = await get_filter(user_id)

    if query.lower().startswith("filter "):
        parts = query.split(maxsplit=1)
        if len(parts) > 1:
            ft = parts[1].lower()
            if ft in ['all', 'email', 'phone', 'name']:
                await set_filter(user_id, ft)
                await update.message.reply_text(f"✅ Фильтр установлен: {ft}", reply_markup=await get_main_keyboard(user_id))
            else:
                await update.message.reply_text("❌ Неверный тип. Используйте: all, email, phone, name", reply_markup=await get_main_keyboard(user_id))
        return
    elif query.lower().startswith("subscribe "):
        parts = query.split(maxsplit=1)
        if len(parts) > 1:
            sub_query = parts[1].strip()
            if sub_query:
                await add_subscription(user_id, sub_query)
                await update.message.reply_text(f"✅ Вы подписались на мониторинг запроса: {sub_query}", reply_markup=await get_main_keyboard(user_id))
            else:
                await update.message.reply_text("❌ Укажите запрос для подписки.", reply_markup=await get_main_keyboard(user_id))
        return
    else:
        results = await search_all(query)
        if "error" in results:
            await update.message.reply_text(results["error"], reply_markup=await get_main_keyboard(user_id))
            return

        if not results:
            results = await fuzzy_search(query)
            if results:
                await update.message.reply_text("🔍 Найдено похожее (умный поиск):", reply_markup=await get_main_keyboard(user_id))
            else:
                await update.message.reply_text("❌ Ничего не найдено.", reply_markup=await get_main_keyboard(user_id))
                return

        if filter_type != 'all':
            filtered = {}
            for src, entries in results.items():
                filtered_entries = []
                for e in entries:
                    if filter_type == 'email' and '@' in e:
                        filtered_entries.append(e)
                    elif filter_type == 'phone' and re.search(r'\+?\d{10,15}', e):
                        filtered_entries.append(e)
                    elif filter_type == 'name' and re.search(r'[А-Яа-я]+\s+[А-Яа-я]+', e):
                        filtered_entries.append(e)
                    else:
                        continue
                if filtered_entries:
                    filtered[src] = filtered_entries
            results = filtered

        if not results:
            await update.message.reply_text("❌ После фильтрации ничего не найдено.", reply_markup=await get_main_keyboard(user_id))
            return

        await save_history(user_id, query, results)

        output = []
        for src, entries in results.items():
            output.append(f"📌 *{src}:*")
            for e in entries:
                output.append(f"   • {e}")
            output.append("")
        reply = "\n".join(output)
        if len(reply) > 4096:
            reply = reply[:4093] + "..."
        await update.message.reply_text(reply, parse_mode="Markdown", reply_markup=await get_main_keyboard(user_id))

# ============================================================
# ===== АДМИН-ПАНЕЛЬ (inline, кнопки работают) ===============
# ============================================================
async def admin_panel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    if not await is_admin(user_id):
        await update.message.reply_text("⛔ Доступ запрещён.", reply_markup=await get_main_keyboard(user_id))
        return
    keyboard = [
        [InlineKeyboardButton("👥 Добавить админа", callback_data="admin_add")],
        [InlineKeyboardButton("🗑 Удалить админа", callback_data="admin_remove")],
        [InlineKeyboardButton("⛔ Добавить в чёрный список", callback_data="blacklist_add")],
        [InlineKeyboardButton("✅ Удалить из чёрного списка", callback_data="blacklist_remove")],
        [InlineKeyboardButton("🎫 Назначить техподдержку", callback_data="support_add")],
        [InlineKeyboardButton("❌ Снять техподдержку", callback_data="support_remove")],
        [InlineKeyboardButton("📩 Тикеты поддержки", callback_data="support_tickets")],
        [InlineKeyboardButton("📊 Статистика", callback_data="stats")],
        [InlineKeyboardButton("📊 Статус бота", callback_data="admin_status")],
        [InlineKeyboardButton("❓ Помощь по админке", callback_data="admin_help")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    await update.message.reply_text("🛠 Админ-панель", reply_markup=reply_markup)

async def admin_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data
    user_id = update.effective_user.id

    if not await is_admin(user_id):
        await query.edit_message_text("⛔ Доступ запрещён.")
        return

    if data == "admin_add":
        await query.edit_message_text("Введите @username пользователя, которого хотите сделать админом:")
        user_states[user_id] = {'action': 'awaiting_admin_add'}
    elif data == "admin_remove":
        await query.edit_message_text("Введите @username пользователя для снятия прав админа:")
        user_states[user_id] = {'action': 'awaiting_admin_remove'}
    elif data == "blacklist_add":
        await query.edit_message_text("Введите текст (ФИО, телефон, email) для добавления в чёрный список:")
        user_states[user_id] = {'action': 'awaiting_blacklist_add'}
    elif data == "blacklist_remove":
        await query.edit_message_text("Введите текст для удаления из чёрного списка:")
        user_states[user_id] = {'action': 'awaiting_blacklist_remove'}
    elif data == "support_add":
        await query.edit_message_text("Введите @username пользователя для назначения техподдержкой:")
        user_states[user_id] = {'action': 'awaiting_support_add'}
    elif data == "support_remove":
        await query.edit_message_text("Введите @username пользователя для снятия техподдержки:")
        user_states[user_id] = {'action': 'awaiting_support_remove'}
    elif data == "support_tickets":
        tickets = await get_open_tickets()
        if not tickets:
            await query.edit_message_text("📭 Нет открытых тикетов.")
            return
        msg = "📩 Открытые тикеты:\n"
        keyboard = []
        for t in tickets:
            msg += f"#{t[0]} от {t[1]} ({t[3]}): {t[2][:50]}...\n"
            keyboard.append([InlineKeyboardButton(f"Ответить на тикет #{t[0]}", callback_data=f"reply_ticket_{t[0]}")])
        msg += "\nВыберите тикет для ответа:"
        reply_markup = InlineKeyboardMarkup(keyboard)
        await query.edit_message_text(msg, reply_markup=reply_markup)
    elif data == "stats":
        users, bl, tickets = await run_sync(get_stats_sync)
        await query.edit_message_text(
            f"📊 *Статистика*\n👤 Пользователей: {users}\n⛔ В чёрном списке: {bl}\n📩 Открытых тикетов: {tickets}",
            parse_mode="Markdown"
        )
    elif data == "admin_status":
        uptime = int((datetime.now() - start_time).total_seconds())
        h = uptime // 3600
        m = (uptime % 3600) // 60
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("SELECT COUNT(*) FROM users")
        users = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM cache")
        cache_count = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM subscriptions")
        subs = c.fetchone()[0]
        conn.close()
        text = (
            f"📊 *Статус бота*\n"
            f"⏱ Время работы: {h}ч {m}м\n"
            f"👤 Пользователей: {users}\n"
            f"💾 Кэш: {cache_count} записей\n"
            f"🔔 Подписок: {subs}"
        )
        await query.edit_message_text(text, parse_mode="Markdown")
    elif data == "admin_help":
        help_text = (
            "📖 *Помощь по админке*\n\n"
            "• Добавить админа – запросит @username\n"
            "• Удалить админа – запросит @username\n"
            "• Добавить в чёрный список – запросит текст\n"
            "• Удалить из чёрного списка – запросит текст\n"
            "• Назначить техподдержку – запросит @username\n"
            "• Снять техподдержку – запросит @username\n"
            "• Тикеты поддержки – список открытых тикетов с кнопками ответа\n"
            "• Статистика – общая статистика\n"
            "• Статус бота – технический статус"
        )
        await query.edit_message_text(help_text, parse_mode="Markdown")
    elif data.startswith("reply_ticket_"):
        ticket_id = int(data.split("_")[2])
        await query.edit_message_text(f"Введите текст ответа на тикет #{ticket_id}:")
        user_states[user_id] = {'action': 'awaiting_ticket_reply', 'ticket_id': ticket_id}

# ============================================================
# ===== ФОНОВЫЙ МОНИТОРИНГ =====================================
# ============================================================
async def monitor_task(application):
    while True:
        await asyncio.sleep(86400)
        subscriptions = await get_subscriptions()
        for user_id, query in subscriptions:
            results = await search_all(query)
            if results and "error" not in results:
                try:
                    await application.bot.send_message(
                        chat_id=user_id,
                        text=f"🔔 Новые данные по запросу '{query}':\n{json.dumps(results, indent=2, ensure_ascii=False)[:1000]}"
                    )
                except:
                    pass

# ============================================================
# ===== ЗАПУСК ================================================
# ============================================================
if __name__ == "__main__":
    init_db_sync()
    app = Application.builder().token(TOKEN).build()

    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    app.add_handler(CallbackQueryHandler(admin_callback, pattern="admin_|reply_ticket_"))

    loop = asyncio.get_event_loop()
    loop.create_task(monitor_task(app))

    print(f"{BOT_NAME} 4.6 запущен (админка по username, без картинок).")
    app.run_polling()
