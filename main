async def get_main_keyboard(user_id=None):
    keyboard = [
        ["📋 Инфо о боте", "📊 Статус"],
        ["❓ Помощь", "📩 Мои тикеты"],
        ["📝 Создать тикет", "📜 История"],
        ["⚙️ Настройки", "📤 Экспорт"],
        ["🔔 Подписка"]
    ]
    if user_id and await is_admin(user_id):
        keyboard.append(["🛠 Админ-панель"])
    return ReplyKeyboardMarkup(keyboard, resize_keyboard=True)

