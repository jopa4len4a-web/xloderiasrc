# ===== ВСПОМОГАТЕЛЬНАЯ ФУНКЦИЯ ДЛЯ СИНХРОННЫХ ВЫЗОВОВ БД =====
async def run_sync(func, *args, **kwargs):
    loop = asyncio.get_running_loop()
    return await loop.run_in_executor(None, func, *args, **kwargs)

# ===== ИНИЦИАЛИЗАЦИЯ БД (СИНХРОННАЯ) =====
def init_db_sync():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            first_name TEXT,
            last_name TEXT,
            registered_at TEXT,
            referred_by INTEGER,
            role TEXT DEFAULT 'user'
        )
    ''')
    c.execute('''
        CREATE TABLE IF NOT EXISTS blacklist (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            pattern TEXT UNIQUE,
            added_by INTEGER,
            added_at TEXT
        )
    ''')
    c.execute('''
        CREATE TABLE IF NOT EXISTS support_tickets (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            message TEXT,
            status TEXT DEFAULT 'open',
            created_at TEXT,
            assigned_to INTEGER,
            reply TEXT
        )
    ''')
    c.execute('''
        CREATE TABLE IF NOT EXISTS referrals (
            referral_code TEXT PRIMARY KEY,
            owner_id INTEGER,
            used_by INTEGER,
            used_at TEXT
        )
    ''')
    conn.commit()
    conn.close()

async def init_db():
    await run_sync(init_db_sync)

# ===== ФУНКЦИИ РАБОТЫ С БД (синхронные, вызываются через run_sync) =====

def get_user_sync(user_id):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT * FROM users WHERE user_id=?", (user_id,))
    row = c.fetchone()
    conn.close()
    return row

async def get_user(user_id):
    return await run_sync(get_user_sync, user_id)

def register_user_sync(user_id, username, first_name, last_name, referred_by=None):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT user_id FROM users WHERE user_id=?", (user_id,))
    if c.fetchone():
        conn.close()
        return
    c.execute("SELECT COUNT(*) FROM users")
    count = c.fetchone()[0]
    role = 'admin' if count == 0 else 'user'
    c.execute(
        "INSERT INTO users (user_id, username, first_name, last_name, registered_at, referred_by, role) VALUES (?, ?, ?, ?, ?, ?, ?)",
        (user_id, username, first_name, last_name, datetime.now().isoformat(), referred_by, role)
    )
    conn.commit()
    conn.close()

async def register_user(user_id, username, first_name, last_name, referred_by=None):
    await run_sync(register_user_sync, user_id, username, first_name, last_name, referred_by)

def is_admin_sync(user_id):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT role FROM users WHERE user_id=?", (user_id,))
    row = c.fetchone()
    conn.close()
    return row and row[0] == 'admin'

async def is_admin(user_id):
    return await run_sync(is_admin_sync, user_id)

